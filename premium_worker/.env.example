# Copy this file to premium_worker/.env or set the variables in the
# Codex automation/local environment. Do not commit real values.

# Existing spreadsheet that contains alerts_raw. Read-only access is enough.
PREMIUM_SPREADSHEET_ID=

# Use one of these Google service account credential options.
# Share the spreadsheet with the service account email as Viewer.
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# New Discord webhook for the dedicated premium channel.
DISCORD_PREMIUM_WEBHOOK_URL=
# Optional fallback for Markdown links in the premium log Reason column.
# Discord's webhook response usually includes guild_id; set this if it does not.
DISCORD_PREMIUM_GUILD_ID=

# Process only inside these JST windows by default.
PREMIUM_ALLOWED_JST_HOURS=13,15
PREMIUM_ALLOWED_JST_MINUTES=13:05-13:10,15:36-15:40
PREMIUM_ALLOWED_JST_WEEKDAYS=1,2,3,4,5
PREMIUM_SIGNAL_TYPES=BOTTOM

# Leave these at 0 to scan all rows and claim every unsent matching alert ID.
# Set positive values only when you intentionally want to cap a manual run.
PREMIUM_MAX_ALERTS_PER_RUN=0
PREMIUM_SCAN_MAX_ROWS=0

# Optional: write premium post/failure logs to a separate spreadsheet.
# This must be different from PREMIUM_SPREADSHEET_ID so the existing GAS
# spreadsheet remains read-only from the worker's point of view.
# Share this log spreadsheet with the service account as Editor.
# Rows older than PREMIUM_LOG_RETENTION_DAYS are automatically deleted.
PREMIUM_LOG_SPREADSHEET_ID=
PREMIUM_LOG_SHEET_NAME=premium_alert_log
PREMIUM_LOG_RETENTION_DAYS=90
